{
  "world": { "width": 1920, "height": 1080 },
  "window": { "width": 1280, "height": 720, "title": "R-Type" },
  "tickRate": 60,
  "files": {
    "clientPrefabs": "rtype_client_prefabs.json",
    "settings": "rtype_settings.json"
  },
  "layers": ["player", "enemy", "player_missile", "enemy_missile"],
  "rules": {
    "startLives": 3,
    "respawnDelay": 2.0,
    "invulnerability": 2.0,
    "gameOverDelay": 5.0,
    "spawnX": 200,
    "spawnY": 200,
    "spawnSpacing": 160,
    "playerPrefab": "player_ship",
    "spawnerPrefab": "bydo_spawner"
  },
  "textures": {
    "player_ships": "sprites/players/r-typesheet42.gif",
    "player_missiles": "sprites/projectiles/r-typesheet1.gif",
    "enemy_missiles": "sprites/projectiles/r-typesheet43.gif",
    "bydos": "sprites/enemies/r-typesheet5.gif",
    "explosions": "sprites/effects/r-typesheet44.gif"
  },
  "fonts": {
    "hud": "fonts/bytebounce.medium.ttf"
  },
  "sounds": {
    "shot": "sounds/LASER_GUN.mp3",
    "explosion": "sounds/EXPLOSION.mp3"
  },
  "music": {
    "main": "music/MAIN_THEME.mp3"
  },
  "startMusic": "main",
  "kinds": {
    "1": "ship",
    "2": "player_missile",
    "3": "bydo",
    "4": "enemy_missile"
  },
  "clientScene": [
    { "prefab": "star_far", "count": 120, "scatter": true },
    { "prefab": "star_mid", "count": 60, "scatter": true },
    { "prefab": "star_near", "count": 25, "scatter": true },
    { "prefab": "hud_line", "components": {
      "Transform": { "x": 24, "y": 16 },
      "Text": { "font": "hud", "size": 28, "color": [80, 200, 255, 255] },
      "StatusText": { "format": "P{slot}  LIVES {lives}  SCORE {score}", "slot": 0 }
    } },
    { "prefab": "hud_line", "components": {
      "Transform": { "x": 484, "y": 16 },
      "Text": { "font": "hud", "size": 28, "color": [255, 90, 200, 255] },
      "StatusText": { "format": "P{slot}  LIVES {lives}  SCORE {score}", "slot": 1 }
    } },
    { "prefab": "hud_line", "components": {
      "Transform": { "x": 944, "y": 16 },
      "Text": { "font": "hud", "size": 28, "color": [120, 255, 120, 255] },
      "StatusText": { "format": "P{slot}  LIVES {lives}  SCORE {score}", "slot": 2 }
    } },
    { "prefab": "hud_line", "components": {
      "Transform": { "x": 1404, "y": 16 },
      "Text": { "font": "hud", "size": 28, "color": [255, 170, 60, 255] },
      "StatusText": { "format": "P{slot}  LIVES {lives}  SCORE {score}", "slot": 3 }
    } },
    { "prefab": "hud_line", "components": {
      "Transform": { "x": 700, "y": 470 },
      "Text": { "font": "hud", "size": 96, "color": [255, 255, 255, 255] },
      "StatusText": { "format": "GAME OVER", "visibleWhen": "over" }
    } }
  ],
  "clientSystems": [
    "Parallax",
    "TiltAnimation",
    "SpriteAnimation",
    "DeathEffect",
    "PlayerLabel",
    "Anchor",
    "StatusText",
    "Audio",
    "Cleanup"
  ],
  "renderSystems": [
    { "system": "Render", "background": [5, 5, 20, 255] }
  ]
}
